# Contact form delivery — Resend (https://resend.com)
# Create an account, add an API key, and put it here (and in Vercel's env vars).
RESEND_API_KEY=

# Optional — where website inquiries are emailed. Comma-separate for multiple.
# Defaults to the site email (info@cesinbox.com) if unset.
CONTACT_TO=info@cesinbox.com

# Optional — the "from" address. Must be on a domain you've verified in Resend.
# Until you verify a domain, the form falls back to Resend's onboarding@resend.dev.
CONTACT_FROM="Cornerstone Website <noreply@cornerstoneengineeringandsurveying.com>"

# --- Supabase (content database + admin) --------------------------------
# Project URL and the PUBLIC (anon / "publishable") key. These are safe to
# expose to the browser; Row-Level Security protects the data. Put the same
# two values in Vercel's env vars.
NEXT_PUBLIC_SUPABASE_URL=https://yywqmbyymfdxaqtfvanc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# The SECRET ("service_role") key — bypasses RLS. SERVER-ONLY. Never commit a
# real value and never prefix it with NEXT_PUBLIC. Set it in .env.local locally
# and in Vercel's env vars for production.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
# Now REQUIRED: visitor analytics, the People page, and the weekly email use it.

# --- Admin roles ---------------------------------------------------------
# The owner can add and remove admins. Everyone else who signs in is an admin.
# Comma-separate for more than one owner.
OWNER_EMAIL=mitch@example.com

# --- Visitor analytics (private, cookie-free) ----------------------------
# Any long random string. Mixed into the daily visitor hash so it can't be
# reversed. Generate one with: openssl rand -hex 32
ANALYTICS_SALT=

# --- Weekly visitor email (Vercel Cron, Mondays 8am Central) -------------
# Any long random string. Vercel sends it to the cron route automatically.
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# --- Search engine verification (optional) -------------------------------
# Paste the code from Google Search Console's "HTML tag" method (content="...").
GOOGLE_SITE_VERIFICATION=
# Paste the code from Bing Webmaster Tools' meta tag method.
BING_SITE_VERIFICATION=
